        <mxCell id="XhsZu9T56RGxZ4pcbJn--78" value="Репликация" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;" parent="XhsZu9T56RGxZ4pcbJn--77" vertex="1" connectable="0">
